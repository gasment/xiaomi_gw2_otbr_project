set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
get_filename_component(MI_GATEWAY_PROJECT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(MI_TOOLCHAIN "${MI_GATEWAY_PROJECT}/toolchains/armv7-musl/bin/arm-buildroot-linux-musleabihf")
if(NOT EXISTS "${MI_TOOLCHAIN}-g++")
  message(FATAL_ERROR "Existing ARM musl toolchain missing: ${MI_TOOLCHAIN}-g++")
endif()
set(CMAKE_CXX_COMPILER "${MI_TOOLCHAIN}-g++")
set(CMAKE_C_COMPILER "${MI_TOOLCHAIN}-gcc")
set(CMAKE_AR "${MI_TOOLCHAIN}-ar")
set(CMAKE_RANLIB "${MI_TOOLCHAIN}-ranlib")
set(CMAKE_STRIP "${MI_TOOLCHAIN}-strip")
set(CMAKE_OBJCOPY "${MI_TOOLCHAIN}-objcopy")
set(CMAKE_OBJDUMP "${MI_TOOLCHAIN}-objdump")
set(CMAKE_READELF "${MI_TOOLCHAIN}-readelf")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
